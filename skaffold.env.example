SKAFFOLD_KUBE_CONTEXT=your-cluster-context
SKAFFOLD_NAMESPACE=passmower
SKAFFOLD_DEFAULT_REPO=registry.example.com/your-user
# Preserve the release, signing keys and identity resources when dev exits.
SKAFFOLD_CLEANUP=false
# Optional, ignored local Helm values containing host and upstream settings.
# PASSMOWER_VALUES_FILE=.local-dev/values.yaml
