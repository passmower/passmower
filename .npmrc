# Refuse to install against a Node the dependencies do not support, rather than
# warning and failing later in a code path nobody exercised. The floor is Node
# 22, set by @simplewebauthn/server 14; see engines in package.json.
#
# This applies to commands run in this repo — its own installs, CI and the
# Docker build. A package's .npmrc is not consulted when someone installs
# passmower as a dependency, so it binds nothing downstream.
#
# Note it enforces every dependency's engines field, not just ours: a transitive
# dependency declaring a range this Node misses will now fail the install
# outright instead of printing EBADENGINE.
engine-strict=true
