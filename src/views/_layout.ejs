<!DOCTYPE html>
<html >
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <link rel="icon" type="image/svg+xml" href="/passmower.svg">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <% if (wide) { %>
    <div class="card card-wide">
    <% } else { %>
    <div class="card">
    <% } %>
      <div class="notice" id="notice" style="display: none">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><!-- Heroicons 2.2.0 exclamation-circle - https://heroicons.com License - MIT, Copyright (c) Tailwind Labs, Inc. --><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/></svg>
        <div>
          <p id="error"></p>
        </div>
      </div>
      <% if (typeof welcome !== 'undefined' && welcome) { %>
      <img class="welcome-logo" src="/passmower.svg" alt="Passmower">
      <% } %>
      <h1><%= title %></h1>
      <%- body %>
      <% if (uid) { %>
      <div class="login-help login-cancel">
        <a href="/interaction/<%= uid %>/abort">[ Log out ]</a>
        <% if (client.tosUri) { %>
          <a href="<%= client.tosUri %>">[ Terms of Service ]</a>
        <% } %>
        <% if (client.policyUri) { %>
          <a href="<%= client.policyUri %>">[ Privacy Policy ]</a>
        <% } %>
      </div>
    </div>
    <% } %>
    <% if (dbg) { %>
    <div class="grant-debug">
      <details>
        <summary style="text-align: center;">(Click to expand) DEBUG information</summary>
        <% if (uid) { %>
        <div>
          <strong>uid</strong>: <%= uid %>
        </div>
        <% } %>

        <div>
          SESSION <br>
         ========= <br>
          <%- dbg.session %>
        </div>

        <div>
          PARAMS <br>
         ======== <br>
          <%- dbg.params %>
        </div>

        <div>
          PROMPT <br>
         ======== <br>
          <%- dbg.prompt %>
        </div>
      </details>
    </div>
    <% } %>
  </body>
  <script nonce="<%= nonce %>">
    const url = new URL(window.location.href);
    const urlParams = new URLSearchParams(url.hash);
    const errorDescription = urlParams.get('error_description')
    if (errorDescription) {
      const notice = document.getElementById('notice');
      notice.style.display = 'block'
      const error = document.getElementById('error');
      error.textContent = errorDescription
    }
  </script>
</html>
